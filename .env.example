# Copy to .env and adjust as needed. Used by docker-compose and local dev.

# General
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# Postgres (docker-compose)
POSTGRES_USER=nivesh
POSTGRES_PASSWORD=nivesh
POSTGRES_DB=nivesh

# Backend (values below match the docker-compose service names;
# override with localhost equivalents when running the backend outside Docker)
DATABASE_URL=postgresql+asyncpg://nivesh:nivesh@localhost:5432/nivesh
# Used only by the repository test suite (backend/tests/market_data/conftest.py);
# point it at a separate database so tests never touch dev data.
TEST_DATABASE_URL=postgresql+asyncpg://nivesh:nivesh@localhost:5432/nivesh_test
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
ALLOWED_ORIGINS=["http://localhost:3000"]

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
